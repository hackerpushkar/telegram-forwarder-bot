# ==========================================
# Telegram Forwarder Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=your_bot_token_here

# 2. Telegram Admin User IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789

# 3. Telegram API Credentials from https://my.telegram.org (Required for Userbot Mode)
# Used to join other people's channels/groups where you are not admin
API_ID=0
API_HASH=

# Optional Session String (if already generated, otherwise log in interactively via /userbot)
SESSION_STRING=

# Database Configuration:
# Leave MONGO_URI empty to use SQLite (default), or provide your MongoDB connection string.
DB_PATH=data/forwarder.db
MONGO_URI=
MONGO_DB_NAME=forwarder_bot

# Bot Settings
# Set to true to allow only ADMIN_IDS to configure routes, or false for public
ADMINS_ONLY=true

# Default Forward Mode: "copy" (clean copy without sender tag) or "forward" (native forward)
DEFAULT_FORWARD_MODE=copy

# Maximum retry attempts when encountering rate limits / network errors
MAX_RETRIES=5
